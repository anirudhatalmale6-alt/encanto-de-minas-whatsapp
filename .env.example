# WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_api_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_PHONE_NUMBER=5534998053310

# Google Sheets
GOOGLE_SHEETS_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials/service-account.json

# Server
PORT=3000
BASE_URL=https://your-domain.com

# Bot Settings
FOLLOWUP_DELAY_MINUTES=5

# Presentation Images (local paths - uploaded to WhatsApp Media API at runtime)
IMAGE_DIR=../
